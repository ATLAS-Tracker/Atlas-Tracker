<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">
    <LinearLayout
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="@string/widget_today"
            android:textColor="#0F1116"
            android:fontFamily="@font/widget_numbers"
            android:textStyle="bold"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="12sp" />
        <TextView
            android:id="@+id/widget_kcal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="— kcal"
            android:textColor="#0454F2"
            android:fontFamily="@font/widget_numbers"
            android:textStyle="bold"
            android:textSize="32sp"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            android:id="@+id/widget_energy_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_energy_remaining_label"
            android:textColor="#0F1116"
            android:fontFamily="@font/widget_emphasis"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="2" />
        <ProgressBar
            android:id="@+id/widget_kcal_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progressDrawable="@drawable/widget_progress"
            android:progressTint="#0454F2"
            android:progressBackgroundTint="#E5EDFF"
            android:max="1000"
            android:progress="0"
            android:indeterminate="false" />
        <TextView
            android:id="@+id/widget_kcal_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_energy_goal_label"
            android:textColor="#657087"
            android:fontFamily="@font/widget_bold"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_scan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_action_background"
            android:contentDescription="@string/widget_scan_description">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_barcode_icon"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/widget_scan"
                android:textColor="#0454F2"
                android:fontFamily="@font/widget_bold"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="10sp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_action_background"
            android:contentDescription="@string/widget_add_description">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_plus_icon"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/widget_add"
                android:textColor="#0454F2"
                android:fontFamily="@font/widget_bold"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="10sp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
