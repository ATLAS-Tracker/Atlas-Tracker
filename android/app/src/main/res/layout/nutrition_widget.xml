<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">
    <LinearLayout
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginEnd="14dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_brand_background"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_today"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/widget_numbers"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingStart="3dp"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="12sp" />
            <TextView
                android:id="@+id/widget_kcal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="—"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/widget_numbers"
                android:textStyle="bold"
                android:textSize="38sp"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeMaxTextSize="38sp"
                android:autoSizeStepGranularity="1sp" />
            <TextView
                android:id="@+id/widget_kcal_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="kcal"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/widget_numbers"
                android:textStyle="bold"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="11sp" />
            <ProgressBar
                android:id="@+id/widget_kcal_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:progressDrawable="@drawable/widget_progress"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#2EFFFFFF"
                android:max="1000"
                android:progress="0"
                android:indeterminate="false" />
            <TextView
                android:id="@+id/widget_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/widget_emphasis"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/widget_carbs_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/widget_carbs"
                        android:textColor="#0F1116"
                        android:fontFamily="@font/widget_numbers"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="11sp" />
                    <TextView
                        android:id="@+id/widget_carbs_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— g"
                        android:textColor="#0F1116"
                        android:fontFamily="@font/widget_numbers"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:maxLines="1" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/widget_carbs_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@drawable/widget_progress"
                    android:progressTint="#F2A51A"
                    android:progressBackgroundTint="#26F2A51A"
                    android:max="1000"
                    android:progress="0"
                    android:indeterminate="false" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/widget_fats_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/widget_fats"
                        android:textColor="#0F1116"
                        android:fontFamily="@font/widget_numbers"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="11sp" />
                    <TextView
                        android:id="@+id/widget_fats_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— g"
                        android:textColor="#0F1116"
                        android:fontFamily="@font/widget_numbers"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:maxLines="1" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/widget_fats_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@drawable/widget_progress"
                    android:progressTint="#16B892"
                    android:progressBackgroundTint="#2616B892"
                    android:max="1000"
                    android:progress="0"
                    android:indeterminate="false" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/widget_protein_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/widget_proteins"
                        android:textColor="#0F1116"
                        android:fontFamily="@font/widget_numbers"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="11sp" />
                    <TextView
                        android:id="@+id/widget_protein_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— g"
                        android:textColor="#0F1116"
                        android:fontFamily="@font/widget_numbers"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:maxLines="1" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/widget_protein_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@drawable/widget_progress"
                    android:progressTint="#1E78FF"
                    android:progressBackgroundTint="#261E78FF"
                    android:max="1000"
                    android:progress="0"
                    android:indeterminate="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_scan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="horizontal"
            android:background="@drawable/widget_action_background"
            android:gravity="center"
            android:contentDescription="@string/widget_scan_description">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_barcode_icon"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/widget_bold"
                android:textSize="15sp"
                android:textColor="#0454F2"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeStepGranularity="1sp"
                android:text="@string/widget_scan"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageView
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="#1F0454F2"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:id="@+id/widget_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="horizontal"
            android:background="@drawable/widget_action_background"
            android:gravity="center"
            android:contentDescription="@string/widget_add_description">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_plus_icon"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/widget_bold"
                android:textSize="15sp"
                android:textColor="#0454F2"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeStepGranularity="1sp"
                android:text="@string/widget_add"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
